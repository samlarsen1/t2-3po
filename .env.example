# Trading212: use a key with read-only permissions. t2-3po only ever sends GET requests.
T212_API_KEY=your_api_key_here
T212_API_SECRET=your_api_secret_here
# Demo: https://demo.trading212.com
T212_BASE_URL=https://live.trading212.com

# Model inference: anthropic (Claude, paid) or ollama (a local model, free)
#MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
# claude-haiku-5-5 is the cheap default; claude-sonnet-5-5 reasons better at about 20x the cost
#CLAUDE_MODEL=claude-haiku-5-5
# Prompt cache lifetime for document digests: 5m, 1h or off
#DIGEST_CACHE_TTL=5m
# Used when MODEL_PROVIDER=ollama. Pull the model first: ollama pull qwen3:4b
#OLLAMA_MODEL=qwen3:4b
#OLLAMA_BASE_URL=http://localhost:11434/v1

# Concentration limits, as a share of total ISA value
#MAX_SECTOR_WEIGHT=0.30
#MAX_POSITION_WEIGHT=0.175

# Directories
#MACRO_THESIS_FILE=theses/macro/core.md
#STOCKS_FILE=../t2-d2/config/stocks.yaml
#THESES_DIR=theses
#REPORTS_DIR=reports
#PROPOSALS_DIR=proposals
#EXPORT_DIR=exports

#LOG_LEVEL=INFO
