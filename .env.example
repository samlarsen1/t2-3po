# Trading212: use a key with read-only permissions. t2-3po only ever sends GET requests.
T212_API_KEY=your_api_key_here
T212_API_SECRET=your_api_secret_here
# Demo: https://demo.trading212.com
T212_BASE_URL=https://live.trading212.com

# Model inference. GEMINI_API_KEY is optional; without it, Claude digests long documents too.
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here
#CLAUDE_MODEL=claude-sonnet-5-5
#GEMINI_MODEL=gemini-flash-latest

# Concentration limits, as a share of total ISA value
#MAX_SECTOR_WEIGHT=0.30
#MAX_POSITION_WEIGHT=0.175

# Directories
#THESES_DIR=theses
#REPORTS_DIR=reports
#PROPOSALS_DIR=proposals
#EXPORT_DIR=exports

#LOG_LEVEL=INFO
