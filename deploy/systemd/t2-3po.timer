# Installed by t2-hq's bin/t2-deploy.
[Unit]
Description=Weekly T2-3PO review (Sunday, after the T2-BB8 harvest)

[Timer]
OnCalendar=Sun 07:00 Europe/London
# Run at the next start-up if the machine was off or asleep at the scheduled time.
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
