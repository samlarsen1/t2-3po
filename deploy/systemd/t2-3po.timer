# Installed by t2-hq's bin/t2-deploy.
[Unit]
Description=Daily T2-3PO review of the five stocks reviewed least recently

[Timer]
# Daily, so each run stays inside Gemini's free-tier daily quota. On Sundays it runs after
# the T2-BB8 harvest and before the advice.
OnCalendar=*-*-* 07:00 Europe/London
# Run at the next start-up if the machine was off or asleep at the scheduled time.
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
